# Loaded through process environment; this service does not read .env automatically.
MC_API_KEY=replace-with-service-key
MC_DB_PATH=memory_connection/connection.db
MC_FAKE=false
MC_API_BASE=https://api.openai.com/v1
MC_PROVIDER_API_KEY=replace-with-provider-key
MC_MODEL=your-chat-model
MC_EMBED_MODEL=your-embedding-model
# Must match the provider's native embedding dimension.
MC_EMBED_DIMENSION=1536
MC_MEMORY_EXPANSION=true
MC_QUERY_EXPANSION=true
MC_SEARCH_SECONDS=12
MC_EXCLUSIVE_BRIDGE_SLOTS=0
MC_COMPLEMENTARY_SLOTS=2
# Optional original-evidence reranker. Without these, source-diversity ordering still runs.
MC_RERANK_MODEL=
MC_RERANK_API_URL=
MC_RERANK_API_KEY=
MC_RERANK_API_FORMAT=cohere
MC_RERANK_SECONDS=2
# Example tested endpoint: https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# Example tested model: qwen3-rerank. The quality benchmark uses 20s rerank / 120s total.
