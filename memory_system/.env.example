# ---- AML Memory System 配置示例 ----
# 复制为 .env 或直接 export 使用。参赛提交时以平台当期 Full 前置清单为准。

# 服务鉴权（平台调用本系统时使用的 Bearer token）
AML_API_KEY=change-me

# ---- 方案 A：OpenAI（第一期默认，对应平台 gpt-4o-mini 条款）----
AML_LLM_MODEL=gpt-4o-mini
AML_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...

# ---- 方案 B：SiliconFlow（项目会自动转为 OpenAI 兼容调用）----
# AML_LLM_MODEL=siliconflow/Qwen/Qwen2.5-7B-Instruct
# SILICONFLOW_API_KEY=sk-...
# AML_LLM_JSON_MAX_TOKENS=2048
# AML_EXTRACT_BATCH_MESSAGES=6
# AML_EMBED_MODEL=siliconflow/BAAI/bge-m3
# AML_EMBED_DIM=1024                 # 必须匹配模型原生输出；非 Matryoshka 模型不会被截断
# 上面两个 siliconflow/<model> 都会自动使用：
#   https://api.siliconflow.cn/v1 + SILICONFLOW_API_KEY
# 如需分别覆盖，可设置 AML_LLM_API_BASE/AML_LLM_API_KEY 和
# AML_EMBED_API_BASE/AML_EMBED_API_KEY。

# ---- 方案 C：任意 OpenAI 兼容端点 ----
# AML_LLM_MODEL=openai/<model-name>
# AML_LLM_API_BASE=https://your-endpoint/v1
# AML_LLM_API_KEY=sk-...

# ---- 离线测试 ----
# AML_FAKE=1
AML_PROVIDER_RPM=600
AML_PROVIDER_SOFT_TPM=15000
# ---- ULM 生命周期（默认值见 app/config.py，说明见 STORAGE.md）----
# AML_SEGMENT_SIM_DROP=0.35          # 语义边界：相邻消息与段质心相似度低于此值即切分
# AML_STORE_EPISODES=1               # 每段保留原始 chunk 作为 episode 记忆（Memory-Doc 兜底）
# AML_NOVELTY_DUP_THRESHOLD=0.97     # 新颖度门控：高于此相似度且文本一致 → NOOP 不调 LLM
# AML_SCENE_JOIN_THRESHOLD=0.55      # MemScene 归并阈值（0.7*cos + 0.3*Jaccard）
# AML_SCENE_TOP_M=5                  # 场景→情景两阶段召回：第一阶段取的场景数
# AML_HEAT_PROMOTE_THRESHOLD=5       # 场景热度超阈值 → 晋升并重置 interaction_count
# AML_PROFILE_TRANSIENT_TTL_DAYS=90  # 未获跨会话支持的 preference 有效期
# AML_MAX_HOT_SCENES=500             # 超出后最低热度场景转冷层（不删除）
# AML_FORGET_THRESHOLD=0             # 艾宾浩斯保留率阈值；0 关闭冷热分层
# AML_RECALL_VECTOR_LIMIT=40        # 各路候選配額不隨 Search top_k 增長
# AML_RECALL_SOURCE_LIMIT=40
# AML_RECALL_FTS_LIMIT=20
# AML_RECALL_PROFILE_LIMIT=8         # 規則另行保留，不占畫像配額
# AML_RECALL_EXPANSION_LIMIT=12      # graph＋scene 合計上限；0 關閉兩者
# AML_RECALL_EXPANSION_MIN_DIRECT=3  # 任一查詢的匹配獨立來源不足此數，或多跳／敘事／文件時擴展
# AML_GRAPH_FUSION_ENABLED=1       # 候選有向圖傳播；0 僅使用內容先驗，無 RRF
# AML_GRAPH_FUSION_MAX_CANDIDATES=256 # metadata 讀取前的候選上限，規則另行保留
# AML_CASCADE_COARSE_LIMIT=50      # 粗排送入 Cross-Encoder 的候選上限
# AML_CASCADE_FINE_LIMIT=12        # CE 精排保留上限
# AML_CASCADE_LLM_LIMIT=10         # LLM 一次比較的候選上限；top_k 不擴大此值
# AML_CE_API_URL=                  # 可留空自動辨識 DashScope／SiliconFlow
AML_CE_MODEL=qwen3-rerank
# AML_CE_API_KEY=                  # 僅在相同 origin 自動沿用 LLM／embedding key
# AML_CE_API_FORMAT=cohere         # cohere 平面格式，或 dashscope 原生嵌套格式
# AML_CE_BATCH_SIZE=24
# AML_CE_RETRY_BATCHES=2           # 單批逾時最多小批重試兩次；共用原階段時限及預算
# AML_CE_RETRY_BATCH_SIZE=4        # 只重評尚未得分的逾時候選，不重送成功項
# AML_CE_MAX_DOCUMENT_BYTES=4000   # 查詢／單元各自的 UTF-8 bytes 上限，超限不截斷
# AML_CE_MAX_REQUEST_BYTES=90000   # 重複 query-document 配對的保守 token 上界
# AML_CE_TIMEOUT_SECONDS=10
# AML_CE_DEADLINE_SECONDS=12
# AML_CHOICE_SEMANTIC_WITNESSES=1 # 回答前用單次 LLM 語意選取原文引用；失敗／預算不足回退關鍵詞
# ---- JEV 獨立支持關係判斷（OpenRouter Decisions API）----
# OPENROUTER_API_KEY=              # 與現有聊天／embedding 提供者分開
# AML_JEV_API_KEY=                 # 如設定，優先於 OPENROUTER_API_KEY
# AML_CHOICE_JEV_SUPPORT=1         # 預設開啟；無 key／FAKE 時記錄跳過，保留原鏈路
# AML_JEV_MODEL=typesafe/jev-1.13
# AML_CHOICE_JEV_MIN_CONFIDENCE=0.8 # 低於此值即復核；需在保留集校準，非準確率保證
# AML_JEV_TIMEOUT_SECONDS=20       # 包含排隊、HTTP 與重試退避的總時限
# AML_JEV_MAX_REQUEST_BYTES=48000  # 超限整階段回退，不截斷原始證據
# AML_RERANK_MAX_PROMPT_BYTES=24000 # LLM 完整列表提示詞的 UTF-8 bytes 上限
# AML_RERANK_CONCURRENCY=2          # CE 批次並發上限
# AML_RERANK_DEADLINE_SECONDS=45    # 主 listwise、格式修復、刪除復核共用上限，仍受 Search 剩餘時間限制
# AML_RERANK_REPAIR_MAX_CALLS=1     # 列表格式最多修復一次；0 關閉
# AML_EVIDENCE_FALLBACK_ITEMS=8      # CE、LLM 均不可用時未評分項的回退上限
# 舊 AML_RERANK_MAX_CANDIDATES / AML_RERANK_BATCH_MAX_CANDIDATES /
# AML_RERANK_CALIBRATION_ANCHORS / AML_EVIDENCE_MIN_RELEVANCE 僅供歷史回放。
# AML_SEARCH_FOLLOWUP_QUERIES=2     # 多跳查詢最多一次補查、最多幾條查詢（0 關閉）
# AML_SEARCH_FOLLOWUP_SECONDS=8     # 補查規劃的秒數上限，仍受總預算限制
# AML_SEARCH_ITEM_MAX_BYTES=6000    # 重排與打包共用證據單元的 UTF-8 bytes 上限
# AML_SEARCH_LOCAL_CONCURRENCY=4    # 同步儲存／索引工作的背景執行緒數
# AML_VECTOR_CHUNK_SIZE=2048        # 精確向量評分分塊大小
# AML_VECTOR_CACHE_BYTES=134217728  # 向量索引快取估計額度；0 關閉快取
# AML_VECTOR_APPROXIMATE=0          # 1 才啟用近似搜尋；須先用業務資料評估漏召回
# AML_VECTOR_EXACT_LIMIT=20000      # 近似模式下，合格候選不超過此數仍精確搜尋
# AML_VECTOR_CANDIDATE_LIMIT=8192   # 近似模式的評分候選額度（至少請求 k）
# AML_EMBED_TIMEOUT_SECONDS=120     # 單次 embedding HTTP 請求超時（Add／Search 共用）
# AML_SEARCH_EMBED_TIMEOUT_SECONDS=120 # 查詢 embedding 階段上限，包含排隊、分批與重試，仍受 Search 剩餘時間限制
# AML_SEARCH_DEADLINE_SECONDS=300    # 單次 Search 硬截止時間（秒），含召回與重排
# AML_SEARCH_MAX_CALLS=12            # 单次 Search 模型调用数上限
# AML_SEARCH_MAX_TOKENS=64000        # 单次 Search 累计 token 上限
# AML_SUMMARY_ROUTE=0                # 1 = 恢复会话摘要召回路（仅消融用）
# AML_SENSITIVE_RECALL_ENABLED=0     # 服务端允许敏感召回；请求仍须 include_sensitive=true
# AML_MEMORY_DEBUG_LOG=              # 默认关闭；显式给路径才记录完整 Add 正文
# AML_SEARCH_DEBUG_LOG=              # 默认关闭；显式给路径才记录完整 Search trace
# ---- Persona 层 P0-P3（IMPROVEMENT_PLAN.md；全部默认开启，置 0 可消融）----
# AML_PROFILE_CONSOLIDATION=1        # P0 每次 Add 后兴趣巩固 → 第一人称 preference AMU
# AML_PROFILE_MIN_SUPPORT=2          # 推断式画像所需的最少支持记忆数
# AML_CORE_PROFILE_MAX_ITEMS=12      # 查询理解画像摘要条数上限
# AML_CORE_PROFILE_MAX_CHARS=1600    # 查询理解画像摘要字符上限
# AML_SEARCH_SOURCE_EXCERPT_CHARS=800 # 非文件查詢的來源節錄門檻；必要引用可超過此值
# AML_INVALIDATE_ENABLED=1           # P1 遗忘请求 → 目标记忆 valid_to 关闭 + suppressed（全路由排除）
# AML_INVALIDATE_MIN_SIM=0.55        # 遗忘目标候选的最低相似度（LLM 二次确认）
# （已移除 AML_SYNTHETIC_TIME：ULM §2.1 禁止伪造时间，无时间戳历史保持未知）
# AML_QUERY_PROFILE_DIGEST=1         # 無選項查詢才使用相關畫像；選擇題只規劃待驗證前提
# 已停用：AML_SEARCH_MAX_ROUNDS、AML_ABSTAIN_CONFIDENCE、AML_CORE_PROFILE_INJECT、
# AML_CORE_PROFILE_TOKEN_BUDGET、AML_CHOICE_ALIGN、AML_CHOICE_AUTOPICK、AML_PERSONA_VIEW_FILTER。
